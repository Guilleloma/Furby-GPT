# Copia este fichero a .env y rellena tus claves. .env no se sube a git.
OPENAI_API_KEY=
PICOVOICE_ACCESS_KEY=
# Ruta absoluta al JSON de la cuenta de servicio de Google Cloud (Text-to-Speech)
GOOGLE_APPLICATION_CREDENTIALS=
# Opcional: ruta al modelo .ppn de la palabra de activación (por defecto, heymatepicovoice.ppn junto a los scripts)
PICOVOICE_KEYWORD_PATH=
# Solo si usas ElevenLabs como TTS
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
